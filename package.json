  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/unit/**/*.test.mjs\"",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:browser-all": "node tools/run-browser-journeys.mjs",
    "test:browser-socle": "node tools/run-browser-journeys.mjs --socle",
    "test:browser-general": "node tools/run-browser-journeys.mjs --famille general",
    "test:fiches-browser": "node tests/fiches-pj-browser.mjs",
    "test:firebase-v3": "node tests/firebase-rules-v3-emulator.mjs",
    "test:firebase-emulators": "firebase emulators:exec --only auth,database --project demo-outil-mj --non-interactive \"node tests/firebase-rules-v3-emulator.mjs && node tests/cloud-sparse-v2-emulator.mjs\"",
    "test:references-browser": "node tests/browser-references-smoke.mjs",
    "test:pwa-sessions": "node tests/lot1-pwa-sessions-browser.mjs",
    "test:startup": "node tests/browser-startup.mjs",
    "test:cloud-migration": "node tests/cloud-sparse-v2-emulator.mjs",
    "build:magic-local": "node tools/build-lot3-local-release.mjs",
    "test:divine": "node tools/run-divine-recipe.mjs",
    "test:divine-ui": "node tests/divin-v5-browser.mjs"
